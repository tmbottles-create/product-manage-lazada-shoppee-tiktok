{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "AppSettings": {
    "OpenAi": {
      "Enabled": true,
      "BaseUrl": "https://api.openai.com/v1/responses",
      "Model": "gpt-5.6",
      "ApiKeyEnvironmentVariable": "OPENAI_API_KEY",
      "TimeoutSeconds": 120,
      "MaxImagesPerRequest": 3
    },
    "Lazada": {
      "AuthorizeUrl": "https://auth.lazada.com/oauth/authorize",
      "AuthBaseUrl": "https://auth.lazada.com/rest",
      "ApiBaseUrl": "https://api.lazada.co.th/rest",
      "AppKey": "",
      "AppSecret": "",
      "CallbackUrl": "",
      "AccessTokenEnvironmentVariable": "LAZADA_ACCESS_TOKEN",
      "RefreshTokenEnvironmentVariable": "LAZADA_REFRESH_TOKEN",
      "TimeoutSeconds": 60,
      "MaxUploadSizeMb": 3
    },
    "ImageKit": {
      "UploadApiUrl": "https://upload.imagekit.io/api/v1/files/upload",
      "UrlEndpoint": "https://ik.imagekit.io/yzx2xk3aq",
      "UploadFolderPath": "/path/to",
      "PrivateKey": "",
      "PrivateKeyEnvironmentVariable": "IMAGEKIT_PRIVATE_KEY",
      "TimeoutSeconds": 60,
      "MaxUploadSizeMb": 25,
      "UseUniqueFileName": false
    },
    "Browser": {
      "SellerCenterUrl": "https://seller.shopee.co.th/portal/product/new",
      "Channel": "chrome",
      "FallbackChannel": "msedge",
      "ExecutablePath": "",
      "Headless": false,
      "DefaultTimeoutMs": 30000
    },
    "Automation": {
      "MaxRetryCount": 3,
      "DelayBetweenProductsMs": 2000,
      "RequireManualPublishConfirmation": true,
      "SaveAsDraftOnly": true
    },
    "Storage": {
      "WorkingDirectory": "Data",
      "SessionFileName": "session.dat",
      "CheckpointFileName": "checkpoint.json",
      "ResultSnapshotFileName": "result-snapshot.json",
      "TemplateFileName": "ShopeeProductTemplate.xlsx",
      "LogFileName": "logs\\product-catalog-.log",
      "OpenAiApiKeyFileName": "openai-api-key.bin",
      "LazadaTokenFileName": "lazada-token.bin"
    },
    "ProductCatalog": {
      "DatabaseFileName": "product-catalog.db",
      "ExportDirectoryName": "exports",
      "TemplateRootDirectory": "D:\\shoppee-lazada-templete",
      "LazadaImageMode": "PublicImageUrl"
    },
    "Selectors": {
      "Common": {
        "LoadingMask": ".loading",
        "ToastMessage": ".toast",
        "PublishSuccessIndicator": "text=/success/i",
        "CaptchaIndicator": "text=/captcha/i",
        "OtpIndicator": "text=/otp/i"
      },
      "Login": {
        "UserAvatar": ".account-info",
        "LoginForm": "input[name='loginKey']"
      },
      "ProductForm": {
        "AddProductButton": "text=Add Product",
        "ProductNameInput": "input[name='productName']",
        "DescriptionEditor": "[contenteditable='true']",
        "CategoryPicker": "text=Category",
        "CategorySearchInput": "input[placeholder*='search']",
        "CategoryConfirmButton": "button:has-text('Confirm')",
        "PriceInput": "input[name='price']",
        "StockInput": "input[name='stock']",
        "WeightInput": "input[name='weight']",
        "LengthInput": "input[name='length']",
        "WidthInput": "input[name='width']",
        "HeightInput": "input[name='height']",
        "SkuInput": "input[name='sku']",
        "ImageUploadInput": "input[type='file']",
        "AddVariationButton": "text=Enable Variations",
        "VariationNameInput": "input[name='variationName']",
        "VariationOptionInput": "input[name='variationOption']",
        "VariationPriceInput": "input[name='variationPrice']",
        "VariationStockInput": "input[name='variationStock']",
        "SaveDraftButton": "button:has-text('Save as draft')",
        "PublishButton": "button:has-text('Publish')",
        "AttributeSection": "text=Attributes"
      }
    }
  }
}
